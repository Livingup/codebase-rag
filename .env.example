# =============================================================================
# Codebase RAG  环境变量配置
# 复制为 .env，填入实际 API Key 后使用（已在 .gitignore 中排除）
# 没有 Key 的行直接删掉，不要留占位值
# =============================================================================

# --- 本地数据目录 ---
CODEBASE_RAG_DATA_DIR=C:/ProgramData/CodebaseRAG

# --- Embedding 服务 ---
GEMINI_EMBED_KEY_1=
DASHSCOPE_API_KEY=

# --- Qdrant 存储服务 ---
QDRANT_HOST=
QDRANT_PORT=
QDRANT_GRPC_PORT=
QDRANT_HTTPS=
QDRANT_API_KEY=

# --- Agent LLM 服务商 ---
GEMINI_KEY_1=
OPENAI_KEY_1=
ANTHROPIC_KEY_1=
ZHIPU_KEY_1=
DEEPSEEK_API_KEY=
LOCAL_DEEPSEEK_API_KEY=
OPENAI_COMPAT_PRIMARY_BASE_URL=
OPENAI_COMPAT_PRIMARY_ENDPOINT_ID=
OPENAI_COMPAT_PRIMARY_KEY_1=
OPENAI_COMPAT_SECONDARY_BASE_URL=
OPENAI_COMPAT_SECONDARY_ENDPOINT_ID=
OPENAI_COMPAT_SECONDARY_KEY_1=
CUSTOM_ANTHROPIC_COMPAT_BASE_URL=
CUSTOM_ANTHROPIC_COMPAT_KEY_1=
CUSTOM_OPENAI_COMPAT_BASE_URL=
CUSTOM_OPENAI_COMPAT_ENDPOINT_ID=
CUSTOM_OPENAI_COMPAT_KEY_1=

# --- Jev 决策模型服务商渠道（三大独立渠道） ---
JEV_OFFICIAL_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=
JEV_VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v4/ai/evaluation-model
VERCEL_API_KEY=

# --- Windows local service settings ---
CODEBASE_RAG_PROGRAM_DIR=C:/Program Files/CodebaseRAG
CODEBASE_RAG_SERVICE_NAME=CodebaseRAG
CODEBASE_RAG_HEALTH_URL=http://127.0.0.1:18080/api/v1/health

# --- Git remote ---
CODEBASE_RAG_GIT_REMOTE=origin
CODEBASE_RAG_GIT_BRANCH=master
