# =============================================================================
# Codebase RAG  环境变量配置
# 复制为 .env，填入实际 API Key 后使用（已在 .gitignore 中排除）
# 没有 Key 的行直接删掉，不要留占位值
# =============================================================================

# --- 本地数据目录 ---
CODEBASE_RAG_DATA_DIR=G:/App/code base rag

# --- Embedding 服务 ---
GEMINI_EMBED_KEY_1=
DASHSCOPE_API_KEY=

# --- Qdrant 存储服务 ---
QDRANT_API_KEY=

# --- Agent LLM 服务商 ---
GEMINI_KEY_1=
OPENAI_KEY_1=
ANTHROPIC_KEY_1=
ZHIPU_KEY_1=
CUSTOM_ANTHROPIC_COMPAT_KEY_1=
CUSTOM_OPENAI_COMPAT_KEY_1=

# --- Windows local service resource settings ---
CODEBASE_RAG_PROGRAM_DIR=C:/Program Files/CodebaseRAG
CODEBASE_RAG_SERVICE_NAME=CodebaseRAG
CODEBASE_RAG_HEALTH_URL=http://127.0.0.1:18080/api/v1/health
CODEBASE_RAG_CONFIG=
CODEBASE_RAG_SOURCE_ROOT=

# --- Git and release settings ---
CODEBASE_RAG_GIT_REMOTE=origin
CODEBASE_RAG_GIT_BRANCH=master
CODEBASE_RAG_COMMIT_MESSAGE=
CODEBASE_RAG_CREATE_TAG=true
CODEBASE_RAG_RELEASE_VERSION=0.1.1
CODEBASE_RAG_RELEASE_TAG=v0.1.1
CODEBASE_RAG_RELEASE_NAME=CodebaseRAG 0.1.1
CODEBASE_RAG_RELEASE_BODY=CodebaseRAG Windows release 0.1.1
CODEBASE_RAG_RELEASE_OUTPUT_DIR=
CODEBASE_RAG_RELEASE_ZIP=
CODEBASE_RAG_RELEASE_SHA256=
CODEBASE_RAG_UPDATE_PACKAGE_ZIP=

# --- Gitee Release publishing ---
GITEE_OWNER=
GITEE_REPO=
GITEE_TOKEN=
